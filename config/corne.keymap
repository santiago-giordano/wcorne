#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

// Migrado desde la config de VIA. Layout del SO: Estados Unidos - Internacional.

#define BASE   0
#define LOWER  1
#define RAISE  2
#define ADJUST 3

/ {
    keymap {
        compatible = "zmk,keymap";

        // 0: Base.
        base_layer {
            display-name = "Base";
            bindings = <
&kp TAB    &kp Q  &kp W  &kp E  &kp R  &kp T        &kp Y  &kp U  &kp I      &kp O    &kp P      &kp BSPC
&kp LSHFT  &kp A  &kp S  &kp D  &kp F  &kp G        &kp H  &kp J  &kp K      &kp L    &kp SEMI   &kp DEL
&kp LCTRL  &kp Z  &kp X  &kp C  &kp V  &kp B        &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH   &kp CAPS
                 &kp LALT  &mo LOWER  &kp SPACE     &kp RET  &mo RAISE  &kp RALT
            >;
        };

        // 1: Lower. Simbolos y flechas.
        lower_layer {
            display-name = "Lower";
            bindings = <
&kp ESC    &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT        &none     &none     &kp UP     &none     &none    &kp BSLH
&kp LSHFT  &kp CARET  &kp AMPS   &kp STAR   &kp UP     &kp TILDE        &none     &kp LEFT  &kp DOWN   &kp RIGHT &kp SQT  &kp EQUAL
&kp LCTRL  &none      &kp PSCRN  &kp LEFT   &kp DOWN   &kp RIGHT        &kp LPAR  &kp RPAR  &kp LBKT   &kp RBKT  &kp MINUS &kp GRAVE
                           &kp LGUI  &trans  &kp SPACE                  &kp RET  &trans  &kp RALT
            >;
        };

        // 2: Raise. Numpad y navegacion.
        raise_layer {
            display-name = "Raise";
            bindings = <
&kp ESC    &none  &none     &kp UP     &none      &kp C_AL_CALC     &kp KP_PLUS   &kp N7  &kp N8  &kp N9  &kp KP_MULTIPLY  &kp BSPC
&kp LSHFT  &none  &kp LEFT  &kp DOWN   &kp RIGHT  &none             &kp KP_MINUS  &kp N4  &kp N5  &kp N6  &kp KP_DIVIDE    &kp DEL
&kp LCTRL  &none  &kp PSCRN &none      &none      &none             &kp COMMA     &kp N1  &kp N2  &kp N3  &kp DOT          &kp EQUAL
                           &kp LGUI  &trans  &kp SPACE              &kp RET  &trans  &kp N0
            >;
        };

        // 3: Adjust (Lower + Raise). Bluetooth y sistema.
        // Bootloader/reset solo afectan a la mitad donde se presionan, por eso estan en ambas.
        // BT_CLR queda en la otra mano, lejos de los perfiles.
        adjust_layer {
            display-name = "Adjust";
            bindings = <
&bootloader      &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4        &none  &none  &none  &none  &none  &bootloader
&sys_reset       &out OUT_USB   &out OUT_BLE   &none         &none         &none               &none  &none  &none  &none  &none  &sys_reset
&studio_unlock   &none          &none          &none         &none         &none               &none  &none  &none  &none  &none  &bt BT_CLR
                                  &trans  &trans  &trans                                       &trans  &trans  &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };
};
